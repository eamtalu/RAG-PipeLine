      "ttl_seconds": null
    },
    "site_home": {
      "pk": "EYE#{customer_code}",
      "sk": "SITE#{site_id}#HOME",
      "ttl_seconds": 3600
    },
    "sites": {
      "pk": "EYE#{customer_code}",
      "sk": "SITES",
      "ttl_seconds": null
    },
    "user_access": {
      "pk": "EYE#{customer_code}",
      "sk": "USER#{user_id}#ACCESS",
      "ttl_seconds": null
    },
    "user_groups": {
      "pk": "EYE#{customer_code}",
      "sk": "USER#{user_id}#GROUPS",
      "ttl_seconds": null
    },
    "user_history": {
      "pk": "EYE#{customer_code}",
      "sk": "USER#{user_id}#HISTORY",
      "ttl_seconds": 2678400
    },
    "user_tasks": {
      "pk": "EYE#{customer_code}",
      "sk": "USER#{user_id}#TASKS",
      "ttl_seconds": null
    },
    "user_watches": {
      "pk": "EYE#{customer_code}",
      "sk": "USER#{user_id}#WATCHES",
      "ttl_seconds": null
    },
    "users": {
      "pk": "EYE#{customer_code}",
      "sk": "USERS",
      "ttl_seconds": null
    },
    "watchables": {
      "pk": "EYE#{customer_code}",
      "sk": "WATCHABLES",
      "ttl_seconds": 600
    }
  },
  "mirror_schema_version": 1,
  "models": {
    "AnswerPayload": {
      "$defs": {
        "ChartBlock": {
          "properties": {
            "kind": {
              "pattern": "^[a-z][a-z_]{1,15}$",
              "title": "Kind",
              "type": "string"
            },
            "labels": {
              "items": {
                "type": "string"
              },
              "maxItems": 48,
              "minItems": 1,
              "title": "Labels",
              "type": "array"
            },
            "reference": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ChartReference"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "series": {
              "items": {
                "$ref": "#/$defs/ChartSeries"
              },
              "maxItems": 6,
              "minItems": 1,
              "title": "Series",
              "type": "array"
            },
            "stacked": {
              "default": false,
              "title": "Stacked",
              "type": "boolean"
            },
            "status": {
              "default": false,
              "title": "Status",
              "type": "boolean"
            },
            "title": {
              "maxLength": 120,
              "title": "Title",
              "type": "string"
            },
            "type": {
              "const": "chart",
              "default": "chart",
              "title": "Type",
              "type": "string"
            },
            "unit": {
              "anyOf": [
                {
                  "maxLength": 24,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Unit"
            }
          },
          "required": [
            "kind",
            "title",
            "labels",
            "series"
          ],
          "title": "ChartBlock",
          "type": "object"
        },
        "ChartReference": {
          "description": "A horizontal line the chart draws, such as a target.",
          "properties": {
            "label": {
              "maxLength": 40,
              "title": "Label",
              "type": "string"
            },
            "value": {
              "title": "Value",
              "type": "number"
            }
          },
          "required": [
            "label",
            "value"
          ],
          "title": "ChartReference",
          "type": "object"
        },
        "ChartSeries": {
          "properties": {
            "name": {
              "maxLength": 60,
              "title": "Name",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "number"
              },
              "maxItems": 48,
              "minItems": 1,
              "title": "Values",
              "type": "array"
            }
          },
          "required": [
            "name",
            "values"
          ],
          "title": "ChartSeries",
          "type": "object"
        },
        "ChoiceBlock": {
          "description": "One question with answers to tap (and a typed answer when allowed): which of two zones,\nwhat level, which watch to swap out.",
          "properties": {
            "allow_typed": {
              "default": true,
              "title": "Allow Typed",
              "type": "boolean"
            },
            "options": {
              "items": {
                "$ref": "#/$defs/ChoiceOption"
              },
              "maxItems": 12,
              "minItems": 1,
              "title": "Options",
              "type": "array"
            },
            "question": {
              "maxLength": 300,
              "title": "Question",
              "type": "string"
            },
            "type": {
              "const": "choice",
              "default": "choice",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "question",
            "options"
          ],
          "title": "ChoiceBlock",
          "type": "object"
        },
        "ChoiceOption": {
          "properties": {
            "command": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Command"
            },
            "detail": {
              "default": "",
              "maxLength": 200,
              "title": "Detail",
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "title": "Id",
              "type": "string"
            },
            "label": {
              "maxLength": 200,
              "title": "Label",
              "type": "string"
            },
            "suggested": {
              "default": false,
              "title": "Suggested",
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "label"
          ],
          "title": "ChoiceOption",
          "type": "object"
        },
        "EntitiesBlock": {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/EntityRef"
              },
              "maxItems": 8,
              "minItems": 1,
              "title": "Items",
              "type": "array"
            },
            "type": {
              "const": "entities",
              "default": "entities",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "items"
          ],
          "title": "EntitiesBlock",
          "type": "object"
        },
        "EntityRef": {
          "properties": {
            "can_watch": {
              "default": true,
              "title": "Can Watch",
              "type": "boolean"
            },
            "id": {
              "maxLength": 128,
              "title": "Id",
              "type": "string"
            },
            "kind": {
              "enum": [
                "delivery",
                "route",
                "location",
                "zone",
                "product",
                "measure"
              ],
              "title": "Kind",
              "type": "string"
            },
            "label": {
              "maxLength": 200,
              "title": "Label",
              "type": "string"
            },
            "site_id": {
              "anyOf": [
                {
                  "maxLength": 16,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Site Id"
            },
            "watched": {
              "default": false,
              "title": "Watched",
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id",
            "label"
          ],
          "title": "EntityRef",
          "type": "object"
        },
        "Evidence": {
          "description": "The rows behind the answer, as data, so the edge draws a real table on the card instead of\nguessing widths from markdown. Optional: absent for answers that rest on no rows. Added on the\nbackend side on 2026-09-27 and mirrored here; both files must stay identical.",
          "properties": {
            "columns": {
              "items": {
                "$ref": "#/$defs/EvidenceColumn"
              },
              "title": "Columns",
              "type": "array"
            },
            "facts": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Small labelled facts under the table: window, sorted by, grain.",
              "title": "Facts",
              "type": "object"
            },
            "link": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Where the same view lives in the app, for an open-in button.",
              "title": "Link"
            },
            "rows": {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "title": "Rows",
              "type": "array"
            },
            "title": {
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "title",
            "columns",
            "rows"
          ],
          "title": "Evidence",
          "type": "object"
        },
        "EvidenceColumn": {
          "properties": {
            "align": {
              "default": "left",
              "enum": [
                "left",
                "right"
              ],
              "title": "Align",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "title": "EvidenceColumn",
          "type": "object"
        },
        "FollowupsBlock": {
          "properties": {
            "items": {
              "items": {
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 1,
              "title": "Items",
              "type": "array"
            },
            "type": {
              "const": "followups",
              "default": "followups",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "items"
          ],
          "title": "FollowupsBlock",
          "type": "object"
        },
        "FormBlock": {
          "description": "A form the person confirms before anything changes (step 8 builds the submit).",
          "properties": {
            "fields": {
              "items": {
                "$ref": "#/$defs/FormField"
              },
              "maxItems": 12,
              "minItems": 1,
              "title": "Fields",
              "type": "array"
            },
            "form_id": {
              "pattern": "^[a-z][a-z0-9_]{0,31}$",
              "title": "Form Id",
              "type": "string"
            },
            "note": {
              "anyOf": [
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            },
            "requires_approval": {
              "default": false,
              "title": "Requires Approval",
              "type": "boolean"
            },
            "submit_label": {
              "default": "Submit",
              "maxLength": 40,
              "title": "Submit Label",
              "type": "string"
            },
            "title": {
              "maxLength": 120,
              "title": "Title",
              "type": "string"
            },
            "type": {
              "const": "form",
              "default": "form",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "form_id",
            "title",
            "fields"
          ],
          "title": "FormBlock",
          "type": "object"
        },
        "FormField": {
          "properties": {
            "kind": {
              "default": "text",
              "enum": [
                "text",
                "number",
                "date",
                "select",
                "checkbox"
              ],
              "title": "Kind",
              "type": "string"
            },
            "label": {
              "maxLength": 80,
              "title": "Label",
              "type": "string"
            },
            "name": {
              "pattern": "^[a-z][a-z0-9_]{0,31}$",
              "title": "Name",
              "type": "string"
            },
            "options": {
              "items": {
                "type": "string"
              },
              "maxItems": 24,
              "title": "Options",
              "type": "array"
            },
            "placeholder": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Placeholder"
            },
            "required": {
              "default": true,
              "title": "Required",
              "type": "boolean"
            },
            "value": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Value"
            }
          },
          "required": [
            "name",
            "label"
          ],
          "title": "FormField",
          "type": "object"
        },
        "ReceiptBlock": {
          "description": "What happened after a confirmation, with a reference and a time-limited undo.",
          "properties": {
            "reference": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reference"
            },
            "status": {
              "default": "done",
              "pattern": "^(done|needs_approval|refused)$",
              "title": "Status",
              "type": "string"
            },
            "text": {
              "maxLength": 300,
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "receipt",
              "default": "receipt",
              "title": "Type",
              "type": "string"
            },
            "undo": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Undo"
            },
            "undo_until": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Undo Until"
            }
          },
          "required": [
            "text"
          ],
          "title": "ReceiptBlock",
          "type": "object"
        },
        "TableBlock": {
          "properties": {
            "columns": {
              "items": {
                "$ref": "#/$defs/EvidenceColumn"
              },
              "maxItems": 12,
              "minItems": 1,
              "title": "Columns",
              "type": "array"
            },
            "rows": {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "maxItems": 25,
              "title": "Rows",
              "type": "array"
            },
            "title": {
              "maxLength": 120,
              "title": "Title",
              "type": "string"
            },
            "type": {
              "const": "table",
              "default": "table",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "title",
            "columns",
            "rows"
          ],
          "title": "TableBlock",
          "type": "object"
        },
        "TextBlock": {
          "properties": {
            "markdown": {
              "maxLength": 4000,
              "title": "Markdown",
              "type": "string"
            },
            "type": {
              "const": "text",
              "default": "text",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "markdown"
          ],
          "title": "TextBlock",
          "type": "object"
        },
        "WatchSuggestionBlock": {
          "description": "At most one per answer: an offer to watch the thing the question was about.",
          "properties": {
            "default_alert": {
              "maxLength": 120,
              "title": "Default Alert",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityRef"
            },
            "text": {
              "maxLength": 300,
              "title": "Text",
              "type": "string"
            },
            "type": {
              "const": "watch_suggestion",
              "default": "watch_suggestion",
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "entity",
            "text",
            "default_alert"
          ],
          "title": "WatchSuggestionBlock",
          "type": "object"
        }
      },
      "description": "The worker's answer, POSTed to the edge at /internal/answers.",
      "properties": {
        "answer": {
          "description": "Markdown text. On status=error a short human sentence.",
          "title": "Answer",
          "type": "string"
        },
        "answered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered At"
        },
        "asked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asked At"
        },
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "chart": "#/$defs/ChartBlock",
                "choice": "#/$defs/ChoiceBlock",
                "entities": "#/$defs/EntitiesBlock",
                "followups": "#/$defs/FollowupsBlock",
                "form": "#/$defs/FormBlock",
                "receipt": "#/$defs/ReceiptBlock",
                "table": "#/$defs/TableBlock",
                "text": "#/$defs/TextBlock",
                "watch_suggestion": "#/$defs/WatchSuggestionBlock"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextBlock"
              },
              {
                "$ref": "#/$defs/TableBlock"
              },
              {
                "$ref": "#/$defs/ChartBlock"
              },
              {
                "$ref": "#/$defs/FormBlock"
              },
              {
                "$ref": "#/$defs/ReceiptBlock"
              },
              {
                "$ref": "#/$defs/FollowupsBlock"
              },
              {
                "$ref": "#/$defs/EntitiesBlock"
              },
              {
                "$ref": "#/$defs/WatchSuggestionBlock"
              },
              {
                "$ref": "#/$defs/ChoiceBlock"
              }
            ]
          },
          "maxItems": 8,
          "title": "Blocks",
          "type": "array"
        },
        "cited_transaction_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cited Transaction Ids",
          "type": "array"
        },
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        },
        "data_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data As Of"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "provisional": {
          "default": false,
          "title": "Provisional",
          "type": "boolean"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_call_count": {
          "default": 0,
          "title": "Tool Call Count",
          "type": "integer"
        }
      },
      "required": [
        "job_id",
        "conversation_id",
        "answer"
      ],
      "title": "AnswerPayload",
      "type": "object"
    },
    "MirrorEnvelope": {
      "description": "One DynamoDB item: the key, what it is, when it is from, and the payload as one JSON string\n(so DynamoDB's no-floats rule never bites and the edge decodes one attribute).",
      "properties": {
        "as_of": {
          "title": "As Of",
          "type": "string"
        },
        "payload_json": {
          "maxLength": 390000,
          "title": "Payload Json",
          "type": "string"
        },
        "pk": {
          "title": "Pk",
          "type": "string"
        },
        "row_type": {
          "title": "Row Type",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sk": {
          "title": "Sk",
          "type": "string"
        },
        "source_version": {
          "default": 0,
          "title": "Source Version",
          "type": "integer"
        },
        "ttl": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl"
        },
        "written_at": {
          "title": "Written At",
          "type": "integer"
        }
      },
      "required": [
        "pk",
        "sk",
        "row_type",
        "as_of",
        "written_at",
        "payload_json"
      ],
      "title": "MirrorEnvelope",
      "type": "object"
    },
    "QuestionJob": {
      "$defs": {
        "Command": {
          "description": "An action the tab asks the backend to perform instead of a question: marking a delivery on\nthe at-risk board as checked (or taking that back), and since step 7c the access-control\nactions of the Admin tab. Rides on a QuestionJob so it reuses the queue, the consumer and the\nanswer poll; the consumer never runs the agent for one. Added on the backend side on\n2026-10-02 and mirrored here; both files must stay identical.",
          "properties": {
            "by": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The Teams display name of the person acting.",
              "title": "By"
            },
            "delivery_number": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Delivery Number"
            },
            "departure_date": {
              "anyOf": [
                {
