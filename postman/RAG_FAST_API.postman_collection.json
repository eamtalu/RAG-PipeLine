{
  "info": {
    "_postman_id": "b7e2a1c4-9f3d-4f7a-8c21-2a1f6d9e0c11",
    "name": "RAG FAST API",
    "description": "All endpoints for the RAG / Transaction-Log FastAPI backend.\n\nFolders:\n- Health\n- Documents - Ingestion (upload + job status)\n- Documents - Search (hybrid vector + keyword search, variations)\n- Logs - Ingestion (push a log file -> Stage 1 parse+insert)\n- Logs - Query (job status + line-level entry queries, all filter variations)\n\nCollection variables:\n- baseUrl        : server origin (default http://localhost:8000)\n- documentJobId  : auto-set by 'Upload document' test script\n- logJobId       : auto-set by 'Ingest log file' test script\n- logFilePath    : default file for log ingest (points at the real mnp-logs sample)\n- docFilePath    : default file for document upload (set your own)\n\nTip: run 'Ingest log file' (or 'Upload document') first; its test script stores the returned job_id into the collection variable, so the matching 'Get ... job' request just works.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness probe. Returns {\"status\":\"ok\"}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents - Ingestion",
      "item": [
        {
          "name": "Upload document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('documentJobId', j.job_id);",
                  "  console.log('documentJobId =', j.job_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{docFilePath}}",
                  "description": "The document to ingest (pdf/docx/md/html/txt)."
                },
                {
                  "key": "document_type",
                  "value": "general",
                  "type": "text",
                  "description": "Optional discriminator passed through the pipeline."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "upload"
              ]
            },
            "description": "Validate + persist a document and create a Job. 201 returns { job_id, filename, status }."
          },
          "response": []
        },
        {
          "name": "Get document job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/jobs/{{documentJobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "jobs",
                "{{documentJobId}}"
              ]
            },
            "description": "Job status + chunk_count for a document upload. Uses documentJobId captured by 'Upload document'."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents - Search",
      "item": [
        {
          "name": "Search - basic (auto keywords)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"what projects has Amin done at Infosapex\",\n  \"top_k\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "search"
              ]
            },
            "description": "Hybrid search; entity keywords auto-extracted from the query."
          },
          "response": []
        },
        {
          "name": "Search - explicit keywords",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"machine learning experience\",\n  \"top_k\": 10,\n  \"keywords\": [\"Infosapex\", \"Python\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "search"
              ]
            },
            "description": "Force specific entity keywords as hard text-match filters."
          },
          "response": []
        },
        {
          "name": "Search - pure vector (keywords [])",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"summarize the candidate's leadership experience\",\n  \"top_k\": 10,\n  \"keywords\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "search"
              ]
            },
            "description": "Empty keywords disables keyword extraction -> pure vector similarity."
          },
          "response": []
        },
        {
          "name": "Search - with metadata filters",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"data pipeline design\",\n  \"top_k\": 5,\n  \"document_type\": \"general\",\n  \"chunk_type\": \"text\",\n  \"job_id\": \"{{documentJobId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "search"
              ]
            },
            "description": "Exact-match filters (document_type / chunk_type / job_id) combined with vector ranking."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Logs - Ingestion",
      "item": [
        {
          "name": "Ingest log file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('logJobId', j.job_id);",
                  "  console.log('logJobId =', j.job_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{logFilePath}}",
                  "description": "An M3 WMS .NET server log file (e.g. eSmartServerLog.txt)."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/logs/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "logs",
                "ingest"
              ]
            },
            "description": "Stage 1: parse the log file and insert raw log_entries. 201 returns { job_id, filename, status }. Test script captures job_id -> logJobId."
          },
          "response": []
        },
        {
          "name": "Scan directory (read-only, deduped)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/logs/scan?directory={{mnpLogsDir}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "logs",
                "scan"
              ],
              "query": [
                {
                  "key": "directory",
                  "value": "{{mnpLogsDir}}",
                  "description": "absolute path to a folder of log files. Files are read-only — never moved/deleted. Omit to use settings.log_source_dir."
                }
              ]
            },
            "description": "Read-only ingest of every file in a directory (e.g. your live rotating logs in mnp-logs). Safe to re-run any time: content-level dedup (entry_hash) skips already-ingested lines, so re-scanning the folder — or the growing active log — only adds genuinely-new entries."
          },
          "response": []
        }
      ]
    },
