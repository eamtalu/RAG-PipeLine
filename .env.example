# --- Core ---
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
DEBUG=false

# --- Object storage (local dir for dev) ---
UPLOAD_DIR=./uploads

# --- OpenAI Embedding ---
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Vector store: pgvector | qdrant | pinecone ---
VECTOR_STORE_BACKEND=pgvector

# --- Qdrant (if used) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Pinecone (if used) ---
PINECONE_API_KEY=
PINECONE_INDEX=documents

# --- Worker ---
WORKER_POLL_SECONDS=2.0

# --- Log-space cleanup (disposable auto-expiry + presence sweep) ---
# OFF by default; DELETE /customers/{code} performs the same purge on demand regardless.
LOGSPACE_CLEANUP_WORKER_ENABLED=false
LOGSPACE_CLEANUP_POLL_SECONDS=3600.0
LOGSPACE_DISPOSABLE_TTL_SECONDS=2592000
LOGSPACE_PRESENCE_TTL_SECONDS=43200

# --- Microsoft Teams bot (consumer process: python -m app.teams_consumer) ---
# Empty queue URL = Teams integration off.
# AWS credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) must NOT go in this file: the app's settings
# reject unknown keys here. Give them to the consumer process only, e.g. Environment= lines in its systemd unit.
# Analytics agent (LangGraph). Local: Ollama on a laptop through an SSH tunnel to localhost:11434.
ANALYTICS_AGENT_MODEL=ollama:qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANALYTICS_AGENT_MAX_ITERATIONS=10
# Ollama only: let Qwen3 'think' before replying (slow, about a minute a turn) and the context size.
ANALYTICS_AGENT_THINK=false
ANALYTICS_AGENT_CONTEXT_TOKENS=16384
# The router: fallbacks tried in order when the pinned provider fails mid-run (comma-separated), and
# a cheaper model for the topic gate (docs/agent-router.md). Empty = none / the primary.
ANALYTICS_AGENT_FALLBACK_MODELS=
ANALYTICS_AGENT_GATE_MODEL=
# The provider guards: one model call's timeout (under the run deadline), calls in flight per
# provider per process, consecutive failures that open the breaker, and its cool-down.
ANALYTICS_AGENT_CALL_TIMEOUT_SECONDS=60
ANALYTICS_AGENT_PROVIDER_BULKHEAD=8
ANALYTICS_AGENT_BREAKER_FAILURES=3
ANALYTICS_AGENT_BREAKER_COOLDOWN_SECONDS=30
# Demand forecast (nightly, per tenant, over the pick_release settled rows). Off by default; enable on
# the WORKER process only. Runs once per tenant-local day after RUN_HOUR_LOCAL, forecasting as of yesterday.
ANALYTICS_FORECAST_WORKER_ENABLED=false
ANALYTICS_FORECAST_POLL_SECONDS=900
ANALYTICS_FORECAST_RUN_HOUR_LOCAL=3
ANALYTICS_FORECAST_SETTLEMENT=pick_release
ANALYTICS_FORECAST_UNITS_VALUE=picked
ANALYTICS_FORECAST_HISTORY_DAYS=120
ANALYTICS_FORECAST_MIN_HISTORY_DAYS=14
ANALYTICS_FORECAST_MIN_DAYS_ETS=21
ANALYTICS_FORECAST_ITEM_DAILY_MIN_ACTIVE_DAYS=10
ANALYTICS_FORECAST_MAX_ITEMS=2000
ANALYTICS_FORECAST_BACKTEST_FOLDS=6
ANALYTICS_FORECAST_SCORE_LAG_HOURS=2
ANALYTICS_FORECAST_ACCURACY_WINDOW_DAYS=28
ANALYTICS_FORECAST_STAFFING_BUFFER_PCT=0.10
# Optional per-tenant override of the automatic rollout-ramp trim, as JSON: {"tmp-live": "2026-09-14"}
ANALYTICS_FORECAST_HISTORY_START={}

TEAMS_SQS_QUEUE_URL=
TEAMS_AWS_REGION=eu-west-2
TEAMS_AWS_ENDPOINT_URL=
TEAMS_EDGE_DYNAMODB_TABLE=
TEAMS_EDGE_ANSWERS_URL=
TEAMS_EDGE_SHARED_SECRET=
TEAMS_CONSUMER_CONCURRENCY=4
TEAMS_SQS_VISIBILITY_SECONDS=600
TEAMS_HISTORY_TURNS=6

# --- Agent admission: questions per tenant and per person per hour, and runs live at once per
# tenant, enforced in the gateway for every channel (docs/agent-quotas.md).
AGENT_QUOTA_TENANT_PER_HOUR=60
AGENT_QUOTA_USER_PER_HOUR=20
AGENT_QUOTA_TENANT_IN_FLIGHT=8

# --- HTTP API callers. Named bearer tokens, `name=token,name=token`; generate one with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Names in API_ADMIN_CALLERS may
# use the admin routes. Leave API_AUTH_REQUIRED=false until every caller sends its token (the log
# line `api.auth.anonymous` shows who does not yet), then switch it on.
API_SERVICE_TOKENS=
API_ADMIN_CALLERS=
API_AUTH_REQUIRED=false

# --- Tenant secrets (webhook URLs, later connector credentials) are sealed at rest under these
# master keys: `kid=<urlsafe base64 of 32 random bytes>,...`. Generate one with
# `python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`.
# Keep the key out of git and out of backups of the database. Rotation: docs/secrets-store.md.
SECRETS_MASTER_KEYS=
SECRETS_ACTIVE_KEY_ID=

# Log lines: "json" (one object per line with request_id and tenant, for journald + jq) or "text".
LOG_OUTPUT=json
